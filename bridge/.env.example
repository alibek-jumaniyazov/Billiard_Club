# ============================================================
#  Billiard Club — bridge agenti sozlamalari (v2)
#  Bu faylni ".env" nomi bilan nusxalang va qiymatlarni to'ldiring.
#  Muhit o'zgaruvchilari (environment variables) .env dan USTUN turadi.
# ============================================================

# --- MAJBURIY ---------------------------------------------------------

# Bulutdagi server manzili (oxirida "/" bo'lmasin)
SERVER_URL=https://billiardclub.uz

# Klub sozlamalari > Chiroq boshqaruvi bo'limida yaratilgan token.
# DIQQAT: token faqat BIR MARTA ko'rsatiladi — darhol shu yerga nusxalang.
BRIDGE_TOKEN=bu-yerga-tokenni-qoying

# --- UMUMIY -----------------------------------------------------------

# Majburiy qayta sinxronizatsiya oralig'i (ms).
# Rele elektr uzilishidan keyin qayta yonganda holat tiklanishi uchun kerak.
# Standart: 60000 (1 daqiqa). Server o'z qiymatini yuborsa — u ustun turadi.
FORCE_SYNC_MS=60000

# Log darajasi: info yoki debug (debug — chaqirilgan URL/topic ham yoziladi).
# Parol va tokenlar hech qanday darajada logga chiqmaydi.
LOG_LEVEL=info

# Serverga so'rov timeouti (ms)
REQUEST_TIMEOUT_MS=5000

# Bitta relega buyruq timeouti (ms). Har bir stolga 3 martagacha urinib ko'riladi.
DEVICE_TIMEOUT_MS=3000

# Oxirgi ma'lum holat saqlanadigan fayl. Internet yo'q bo'lsa agent qayta
# ishga tushganda shu fayldagi holatni qo'llaydi (klub qorong'ida qolmasin).
# STATE_FILE=/opt/billiardclub-bridge/state.json

# Rele parollari / Home Assistant tokenlarini SHU FAYLGA yozishga ruxsat.
# Standart holatda (0) parollar diskka UMUMAN yozilmaydi — internet yo'q bo'lganda
# parol talab qiladigan qurilmalar o'tkazib yuboriladi (bu haqda logga yoziladi).
# 1 qilinsa fayl faqat egasi uchun (0600) yaratiladi, lekin ichida ochiq parol bo'ladi
# (Windows da fayl rejimi cheklanmaydi — papkani boshqalarga ochib qo'ymang).
# CACHE_SECRETS=0

# --- MQTT (faqat "mqtt" drayveri ishlatilsa) --------------------------
# Zigbee2MQTT, Tasmota MQTT, Shelly MQTT va h.k. uchun.
# Parol FAQAT shu faylda qoladi — serverga hech qachon yuborilmaydi.

# MQTT_URL=mqtt://192.168.1.10:1883
# MQTT_USER=billiard
# MQTT_PASS=broker-paroli
# MQTT_CLIENT_ID=billiardclub-bridge
# MQTT_KEEPALIVE_SEC=30

# mqtts:// (TLS) ishlatilsa sertifikat STANDART holatda tekshiriladi.
# O'z-o'zidan imzolangan sertifikat bo'lsa — CA faylini ko'rsating:
# MQTT_CA=C:\billiard-bridge\broker-ca.crt
# Faqat oxirgi chora (tekshiruvni butunlay o'chiradi, parol MITM xavfi ostida qoladi):
# MQTT_TLS_INSECURE=0

# --- Qurilma qidirish (discover) --------------------------------------
# Panelda "Qurilmalarni qidirish" bosilganda skanerlanadigan tarmoq.
# Bo'sh qoldirilsa agent serverga chiqish yo'lidagi interfeysdan aniqlaydi (/24) —
# Docker / VPN adapterlari chetlab o'tiladi. Noto'g'ri tarmoq tanlansa shu yerda yozing.

# SUBNET=192.168.1
# DISCOVER_TIMEOUT_MS=700
# DISCOVER_PARALLEL=32
