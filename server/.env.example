# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=prime_billiard
DB_USER=postgres
DB_PASS=
# Boshqariladigan/masofaviy PostgreSQL (TLS talab qiladigan) uchun true qiling.
# Production da shifrlangan ulanish TAVSIYA etiladi. Faqat NODE_ENV=production da amal qiladi.
DB_SSL=false

# JWT — kuchli tasodifiy qiymatlar QO'YISH SHART:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
# Access token QISQA bo'lishi SHART. U stateless: DB da saqlanmaydi va
# tekshirilmaydi, shuning uchun sessiyani bekor qilish (logout, xodimni
# bloklash, parol almashtirish) FAQAT shu muddat o'tgach to'liq kuchga
# kiradi — bekor qilingan access token o'z TTL si tugaguncha amal qiladi.
# Uzluksizlik rotatsiyali refresh oqimi zimmasida (klient jimgina yangilaydi).
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend manzili (CORS uchun). Production: haqiqiy domen, masalan https://billiardclub.uz
FRONTEND_URL=http://localhost:5173

# Reverse proxy (nginx/Caddy) ORTIDA ishlatsangiz — MAJBURIY true qiling.
# Aks holda rate-limit va login blokirovkasi barcha foydalanuvchilarni bitta
# proxy IP si deb ko'radi (X-Forwarded-For orqali haqiqiy IP olinmaydi).
TRUST_PROXY=false

# Stol chiroqlari — DIRECT rejimi uchun ruxsat etilgan tarmoqlar.
#
# Bo'sh bo'lsa (STANDART) DIRECT rejimi ISHLAMAYDI — bu ataylab: bulutli deployda
# 10/8, 172.16/12, 192.168/16 oraliqlarida serverning O'Z bazasi va ichki panellari
# turadi, ochiq qoldirilsa klub admini ular bilan port skanerlashi mumkin edi.
# Faqat server klub bilan BIR TARMOQDA bo'lganda (on-premise) to'ldiring.
# Bulutdagi server uchun to'g'ri yechim — BRIDGE agent (docs/LIGHT-CONTROL.md).
#
# Format: vergul bilan ajratilgan IPv4 CIDR (yakka IP = /32). Masalan:
#   LIGHTS_DIRECT_ALLOWED_CIDRS=192.168.1.0/24,192.168.2.50
LIGHTS_DIRECT_ALLOWED_CIDRS=

# Telegram bot — yangi klub qo'shilganda va obuna uzaytirilganda sizga xabar boradi.
# 1) @BotFather da bot yarating, tokenini oling
# 2) Botga /start yozing (guruhga qo'shsangiz — guruhga yozing)
# 3) https://api.telegram.org/bot<TOKEN>/getUpdates dan chat.id ni oling
#
# GURUH ID SI O'ZGARISHI MUMKIN: oddiy guruhga admin qo'shilsa yoki tarix
# yoqilsa Telegram uni supergroup'ga aylantiradi va ID butunlay o'zgaradi
# (masalan -5534362630 -> -1004487367602). Server buni O'ZI aniqlaydi:
# yangi ID javobdan olinadi, platform_settings('telegram_chat_id') ga
# saqlanadi va xabar darhol qayta yuboriladi. Ya'ni bu yerdagi qiymat
# eskirsa ham xabarnomalar to'xtamaydi.
#
# Tekshirish: superadmin panelida Sozlamalar -> «Sinov xabari».
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Superadmin — `npm run seed` birinchi ishga tushirishda yaratadi
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=

# Dev: demo klub yaratilsinmi (production da hech qachon true qilmang)
SEED_DEMO_CLUB=false

# Desktop o'rnatgichlari (.exe/.dmg/.AppImage) saqlanadigan papka.
# Bo'sh bo'lsa: <server>/uploads/releases
# DIQQAT: Docker/konteynerda ishlatsangiz bu papkani DOIMIY diskka (volume)
# ulang — aks holda har deploy'da relizlar o'chib, o'rnatilgan desktop
# dasturlar yangilanishni topa olmay qoladi.
RELEASES_DIR=

# Oflayn obuna ruxsatnomasini imzolash kaliti (ECDSA P-256, PKCS8 PEM).
#
# NIMA UCHUN: internet uzilganda server so'ralmaydi, shuning uchun klient
# obuna muddatini O'ZI tekshiradi. Buni ishonchli qilish uchun server har bir
# javobda imzolangan "ruxsatnoma" beradi — klient uni faqat TEKSHIRA oladi,
# o'zgartira olmaydi.
#
# Bo'sh qoldirsangiz server birinchi ishga tushishda kalitni O'ZI yaratadi va
# LICENSE_KEY_FILE ga (standart: <server>/uploads/license-key.pem) yozadi.
#
# DIQQAT: bir nechta nusxada (bir nechta server yoki pod) ishlatsangiz bu
# qiymatni OCHIQ belgilash SHART — aks holda har nusxa o'z kalitini yaratadi
# va bir nusxa bergan ruxsatnomani klient boshqasining kaliti bilan tekshirib
# rad etadi. Yaratish:
#   node -e "const c=require('crypto');console.log(c.generateKeyPairSync('ec',{namedCurve:'prime256v1'}).privateKey.export({type:'pkcs8',format:'pem'}))"
LICENSE_PRIVATE_KEY=
LICENSE_KEY_FILE=
