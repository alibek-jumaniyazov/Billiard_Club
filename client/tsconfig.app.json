{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    /* Brauzer kodi Node API lariga MURAJAAT QILA OLMASIN: `@types/node`
       ataylab faqat tsconfig.node.json (vite konfigi va plaginlar) ga
       ulangan. Aks holda `src/` da tasodifan `process`/`fs` ishlatilishi
       kompilyatsiyada o'tib ketib, brauzerda ishga tushganda yiqilardi. */
    "types": ["vite/client"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  },
  "include": ["src"]
}
